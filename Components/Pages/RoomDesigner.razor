@page "/roomdesigner"
@rendermode InteractiveServer
<div class="app-container" @onmousemove="OnMouseMoveCanvas" @onmouseup="OnMouseUpCanvas">
    <div class="status-bar">
        ToolboxX: @ScreenX ToolBoxY: @ScreenY // StartX: @startX StartY: @startY || Secili Liste: @appState.SelectedItems.Count()
        || Nesnenin Basili durumu: @isDraggingDesignItem.ToString() || DesignItemX: @CurrentDesignItemX DesignItenY: @CurrentDesignItemY
    </div>
    
        <div class="toolbox" style="left: @(ToolBoxX)px; top: @(ToolBoxY)px">
            <header class="header no-select" @onmousedown="OnToolBoxMouseDown" @onmouseup="OnToolBoxMouseUp">Toolbox</header>
            <div class="content">
                <ul class="tool-list">
                    <li>
                        <button class="tool-btn" data-tooltip="Koltuk" @onclick="()=>AddNewItem(DesignItemType.armchair)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"></path>
                                <path d="M3 11v5a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0Z"></path>
                                <path d="M5 18v2"></path>
                                <path d="M19 18v2"></path>
                            </svg>
                        </button>
                    </li>
                    <li>
                    <button class="tool-btn" data-tooltip="Sandalye" @onclick="() => AddNewItem(DesignItemType.chair)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 4v7"></path>
                                <path d="M17 4v7"></path>
                                <path d="M6 11h12v2H6z"></path>
                                <path d="M8 13v8"></path>
                                <path d="M16 13v8"></path>
                            </svg>
                        </button>
                    </li>
                    <li>
                    <button class="tool-btn" data-tooltip="Masa" @onclick="() => AddNewItem(DesignItemType.table)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 8h18v3H3z"></path>
                                <path d="M5 11v10"></path>
                                <path d="M19 11v10"></path>
                                <path d="M9 11v4"></path>
                                <path d="M15 11v4"></path>
                            </svg>
                        </button>
                    </li>
                    <li>
                    <button class="tool-btn" data-tooltip="Sahne" @onclick="() => AddNewItem(DesignItemType.stage)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 16h20v4H2z"></path>
                                <path d="M6 16v-4"></path>
                                <path d="M18 16v-4"></path>
                                <path d="M4 12h16v-2H4z"></path>
                            </svg>
                        </button>
                    </li>
                </ul>

                <header class="header no-select">Parameters</header>
                <ul class="parameters-list">
                    <li>
                        <label class="parameters-label">Prefix</label><br />
                        <input type="text" class="parameters-input" maxlength="3" @bind="PrefixName"/>
                    </li>
                    <li>
                        <label class="parameters-label">Number</label><br />
                    <input type="number" class="parameters-input" @bind="PrefixNumber" min="1" max="999" oninput="if(this.value.length > 3) this.value = this.value.slice(0, 3);" />
                    </li>
                </ul>



            </div>
        </div>

        <div class="canvas-area" @onmousedown="OnCanvasMouseDown">
            @foreach (var item in appState.Items)
            {
            <div class="design-item @(item.IsSelected ? "selected" : "")"
                 style="left: @(item.X)px; top: @(item.Y)px; width: @(item.Width)px; height: @(item.Height)px; background-color: @(item.Color)"
                 @onclick="e => DesignItemClick(e, item)" @onmousedown="e=>DesignItemMouseDown(e, item)" @onmouseup="e=>DesignItemMouseUp(e, item)" @onmousedown:stopPropagation="true">
                @GetItemIcon(item.Type)
                <span>@item.Name</span>
            </div>
            }
        </div>
    
    @if (isSelectingArea)
    {
        <div class="selection-box" style="left: @(SelectionBoxX)px; top: @(SelectionBoxY)px; width: @(SelectionBoxWidth)px; height: @(SelectionBoxHeight)px"></div>
    }


</div>
