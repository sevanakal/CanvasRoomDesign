@page "/roomdesigner"
@rendermode InteractiveServer
<div class="app-container" @onmousemove="OnMouseMoveCanvas" @onmouseup="OnMouseUpCanvas" @onkeydown="CanvasAreaKeyboardDownListener" tabindex="0">
    <div class="status-bar">
        ToolboxX: @ScreenX ToolBoxY: @ScreenY // StartX: @startX StartY: @startY || Secili Liste: @appState.SelectedItems.Count()
        || Nesnenin Basili durumu: @isDraggingDesignItem.ToString() || DesignItemX: @CurrentDesignItemX DesignItenY: @CurrentDesignItemY
        || Pressed Key Down: @KeyDownListener
    </div>

    <div class="toolbox" style="left: @(ToolBoxX)px; top: @(ToolBoxY)px" @onmousedown:stopPropagation="true" @onkeydown:stopPropagation="true">
        <header class="header no-select" @onmousedown="OnToolBoxMouseDown" @onmouseup="OnToolBoxMouseUp">Toolbox</header>
        <div class="content">
            <ul class="tool-list">
                <li>
                    <button class="tool-btn" data-tooltip="Koltuk" @onclick="() => AddNewItem(DesignItemType.armchair)">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"></path>
                            <path d="M3 11v5a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-4 0Z"></path>
                            <path d="M5 18v2"></path>
                            <path d="M19 18v2"></path>
                        </svg>
                    </button>
                </li>
                <li>
                    <button class="tool-btn" data-tooltip="Sandalye" @onclick="() => AddNewItem(DesignItemType.chair)">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 4v7"></path>
                            <path d="M17 4v7"></path>
                            <path d="M6 11h12v2H6z"></path>
                            <path d="M8 13v8"></path>
                            <path d="M16 13v8"></path>
                        </svg>
                    </button>
                </li>
                <li>
                    <button class="tool-btn" data-tooltip="Masa" @onclick="() => AddNewItem(DesignItemType.table)">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 8h18v3H3z"></path>
                            <path d="M5 11v10"></path>
                            <path d="M19 11v10"></path>
                            <path d="M9 11v4"></path>
                            <path d="M15 11v4"></path>
                        </svg>
                    </button>
                </li>
                <li>
                    <button class="tool-btn" data-tooltip="Sahne" @onclick="() => AddNewItem(DesignItemType.stage)">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 16h20v4H2z"></path>
                            <path d="M6 16v-4"></path>
                            <path d="M18 16v-4"></path>
                            <path d="M4 12h16v-2H4z"></path>
                        </svg>
                    </button>
                </li>
            </ul>

            <header class="header no-select">Parameters</header>
            <ul class="parameters-list">
                <li>
                    <label class="parameters-label">Prefix</label><br />
                    <input type="text" class="parameters-input" maxlength="3" @bind="PrefixName" @bind:event="oninput" />
                </li>
                <li>
                    <label class="parameters-label">Number</label><br />
                    <input type="text" pattern="[0-9]*" maxlength="3" class="parameters-input" @bind="PrefixNumber" @bind:event="oninput" />
                </li>
            </ul>



        </div>
    </div>


    @if (appState.SelectedItems.Count() == 1)
    {
        var left = appState.SelectedItems.FirstOrDefault().X;
        var top = appState.SelectedItems.FirstOrDefault().Y;
        <div class="proparties" style="left: @(left + 50)px; top: @(top + 50)px;" @onmousedown:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="header">Proarties</div>
            <div class="content">
                <ul>
                    <li>
                        <span>Prefix/Nr.</span><input type="text" maxlength="8" @bind="@appState.SelectedItems.FirstOrDefault().Name" @bind:event="oninput" />
                    </li>
                </ul>
            </div>
        </div>
    }

    @if (appState.SelectedItems.Count() > 1)
    {
        var left = appState.SelectedItems.LastOrDefault().X;
        var top = appState.SelectedItems.LastOrDefault().Y;
        <div class="grouparea" style="left: @(left+50)px; top: @(top+50)px;" @onmousedown:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="header">Add Group</div>
            <ul>
                <li>
                    <span>Group Name</span><input type="text" maxlength="10" @bind="CreatadGroup.Name" @bind:event="oninput"/>
                </li>
                <li>
                    <span>Group Color</span>
                    <div class="custom-combobox">

                        <div class="combobox-trigger" @onclick="() => isGroupColorPickerOpen = !isGroupColorPickerOpen" style="background-color: @CreatadGroup.Color">
                            
                        </div>

                        @if (isGroupColorPickerOpen)
                        {
                            <div class="combobox-dropdown">
                                @foreach (var color in groupColors)
                                {
                                    <div class="color-item"
                                         style="background-color: @color;"
                                         title="@color"
                                         @onclick="() => SelectGroupColor(color)">
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </li>
                <li>
                    <button class="group-btn" @onclick="CreateGroupButtonClick" @onclick:stopPropagation="true">Create Group</button>
                </li>
            </ul>
        </div>    
    }

    

    <div class="canvas-area" @onmousedown="OnCanvasMouseDown">
        @foreach (var item in appState.Items)
        {
            <div class="design-item @(item.IsSelected ? "selected" : "")"
                 style="left: @(item.X)px; top: @(item.Y)px; width: @(item.Width)px; height: @(item.Height)px; background-color: @(item.Color)"
                 @onclick="e => DesignItemClick(e, item)" @onmousedown="e => DesignItemMouseDown(e, item)" @onmouseup="e => DesignItemMouseUp(e, item)" @onmousedown:stopPropagation="true">
                @GetItemIcon(item.Type)
                <span>@item.Name</span>
                @if (item.IsAddedToGroup)
                {
                    <div class="group-border" style="background-color: @(item.GroupColor)"></div>
                }
                
            </div>
        }
    </div>
    
    @if (isSelectingArea)
    {
        <div class="selection-box" style="left: @(SelectionBoxX)px; top: @(SelectionBoxY)px; width: @(SelectionBoxWidth)px; height: @(SelectionBoxHeight)px"></div>
    }


</div>
